[Unit]
Description=Navidrome Discord status bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nds-bridge
Group=nds-bridge
ExecStart=/usr/local/bin/nds-bridge
Restart=on-failure
RestartSec=5s
# Only signal nds-bridge on stop; it clears every status and shuts its workers
# down itself before exiting.
KillMode=mixed

# Settings without secrets; see bridge.env.example.
EnvironmentFile=/etc/navidrome-discord-status/bridge.env
# Secrets stay readable by root only and are handed to the service by systemd;
# the bridge finds them in $CREDENTIALS_DIRECTORY by these names.
LoadCredential=discord-client-secret:/etc/navidrome-discord-status/credentials/discord-client-secret
LoadCredential=event-secret:/etc/navidrome-discord-status/credentials/event-secret

StateDirectory=navidrome-discord-status
StateDirectoryMode=0700
UMask=0077

# Sandbox. The workers inherit it.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Refuse blocked calls with an error instead of killing the process.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
