# /etc/navidrome-discord-status/bridge.env, the settings for nds-bridge.
# Secrets don't go here, the systemd unit passes them in as credentials.
# All settings are explained in bridge/README.md.

# Where the bridge listens: events from the plugin and the link page.
NDS_EVENTS_ADDR=192.0.2.17:8090
NDS_WEB_ADDR=192.0.2.17:8091

# The address people open to link their account. Discord sends them back to
# this address with /callback appended, so register exactly that in the
# Discord developer portal.
NDS_PUBLIC_URL=http://192.0.2.17:8091

# Navidrome, used once per sign-in to check the username and password.
NDS_NAVIDROME_URL=http://192.0.2.10:4533

# If you put an https reverse proxy in front, use its addresses instead, e.g.
#   NDS_PUBLIC_URL=https://presence.example.com
#   NDS_NAVIDROME_URL=https://music.example.com
# and let the bridge trust the proxy's X-Forwarded-For header:
#   NDS_TRUSTED_PROXIES=192.0.2.16

# Discord application ID, a long number (developer portal, General Information).
NDS_DISCORD_APP_ID=

NDS_WORKER_PATH=/opt/navidrome-discord-status/nds-worker

# Shown in the privacy notice.
NDS_PRIVACY_CONTACT=admin@example.com
# Remove links unused for this many days (0 keeps them until the user unlinks).
NDS_LINK_RETENTION_DAYS=365
# Should match how long journald keeps logs on this machine.
NDS_LOG_RETENTION_DAYS=14

# Optional: small icon shown while paused.
#NDS_PAUSE_IMAGE_URL=https://example.com/pause.png
# debug, info, warn or error
#NDS_LOG_LEVEL=info
